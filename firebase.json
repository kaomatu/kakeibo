{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      ".git/**",
      ".gitignore",
      ".DS_Store",
      "node_modules/**",
      "docs/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
